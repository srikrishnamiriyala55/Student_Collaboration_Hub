<%@ page contentType="text/html; charset=UTF-8" %><%@ taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core" %>
<a href="${ctx}/projects">← All projects</a><div class="page-heading"><div><p class="eyebrow"><c:out value="${project.category}"/> · <c:out value="${project.status}"/></p><h1><c:out value="${project.title}"/></h1><p>Created by <c:out value="${project.owner_name}"/> · <c:out value="${project.created_at}"/></p></div><c:if test="${canManage}"><div class="actions"><a class="button secondary" href="${ctx}/project-update?id=${project.id}">Edit project</a><form action="${ctx}/project-delete" method="post" data-confirm="Archive this project? The team and project history will be preserved."><%@ include file="parts/csrf.jspf" %><input name="id" value="${project.id}" type="hidden"><button class="danger">Archive</button></form></div></c:if></div>
<div class="grid detail-grid"><section class="card"><h2>About the project</h2><p class="preserve"><c:out value="${project.description}"/></p><h3>What we’re looking for</h3><p class="preserve"><c:out value="${project.requirements}"/></p><h3>Technologies</h3><p class="tech"><c:out value="${project.technologies}"/></p><h3>Project progress</h3><progress max="${project.task_count == 0 ? 1 : project.task_count}" value="${project.completed_count}"></progress><p class="muted"><c:out value="${project.completed_count}"/> of <c:out value="${project.task_count}"/> tasks completed</p></section><aside class="card"><div class="section-head"><h2>The team</h2><span class="count"><c:out value="${project.member_count}"/> / <c:out value="${project.capacity}"/></span></div><c:forEach items="${members}" var="m"><div class="member"><span class="avatar small-avatar">◎</span><div><strong><c:out value="${m.name}"/></strong><small><c:out value="${m.team_role}"/></small><c:if test="${canCollaborate}"><small><c:out value="${m.email}"/></small></c:if><small>Joined <c:out value="${m.joined_at}"/></small></div></div></c:forEach><c:if test="${canManage}"><a class="button secondary full" href="${ctx}/students">+ Invite teammates</a></c:if></aside></div>
<c:choose><c:when test="${canCollaborate}"><section class="section"><div class="section-head"><h2>Project tasks</h2><span class="muted">A clear next step for everyone.</span></div><%@ include file="parts/task-list.jspf" %><c:if test="${project.status != 'ARCHIVED'}"><details class="card"><summary>+ Create a task</summary><form method="post" action="${ctx}/task-create" class="section"><%@ include file="parts/csrf.jspf" %><input type="hidden" name="projectId" value="${project.id}"><label>Task title<input name="title" maxlength="180" required></label><label>Description<textarea name="description" rows="2" maxlength="5000"></textarea></label><div class="grid two"><label>Assign to<select name="assigneeId"><c:forEach items="${members}" var="m"><option value="${m.id}"><c:out value="${m.name}"/></option></c:forEach></select></label><label>Priority<select name="priority"><option>MEDIUM</option><option>HIGH</option><option>LOW</option></select></label><label>Deadline<input name="deadline" type="date"></label><label>Status<select name="status"><option>PENDING</option><option>IN_PROGRESS</option><option>COMPLETED</option></select></label></div><button>Create task</button></form></details></c:if></section>
<div class="grid two section"><section class="card"><h2>Team discussion</h2><c:if test="${isMember and project.status != 'ARCHIVED'}"><form method="post" action="${ctx}/discussions"><%@ include file="parts/csrf.jspf" %><input type="hidden" name="projectId" value="${project.id}"><label>Share an update<textarea name="message" maxlength="5000" rows="3" placeholder="What’s on your mind?" required></textarea></label><button>Post update</button></form></c:if><c:forEach items="${messages}" var="d"><article class="list-item"><strong><c:out value="${d.author_name}"/></strong><p class="preserve"><c:out value="${d.message}"/></p><small><c:out value="${d.created_at}"/></small></article></c:forEach><c:if test="${empty messages}"><p class="muted">No discussion yet. Start the conversation.</p></c:if></section><section class="card"><h2>Shared files</h2><c:if test="${isMember and project.status != 'ARCHIVED'}"><form method="post" action="${ctx}/files" enctype="multipart/form-data"><%@ include file="parts/csrf.jspf" %><input type="hidden" name="projectId" value="${project.id}"><label>Choose a file<input type="file" name="file" accept=".pdf,.png,.jpg,.jpeg,.txt,.csv" required><small>PDF, PNG, JPG, TXT, CSV · Maximum 10 MB</small></label><button>Upload file</button></form></c:if><c:forEach items="${files}" var="f"><article class="list-item"><a href="${ctx}/files?id=${f.id}"><c:out value="${f.original_name}"/> ↓</a><small><c:out value="${f.uploader_name}"/> · <c:out value="${f.size_bytes}"/> bytes · <c:out value="${f.created_at}"/></small></article></c:forEach><c:if test="${empty files}"><p class="muted">Shared files will appear here.</p></c:if></section></div></c:when><c:otherwise><div class="info section">Tasks, conversations, and files are available to this project’s team. The project owner can invite you to join.</div></c:otherwise></c:choose>
