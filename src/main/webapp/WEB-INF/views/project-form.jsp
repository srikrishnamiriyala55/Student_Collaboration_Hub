<%@ page contentType="text/html; charset=UTF-8" %><%@ taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core" %>
<div class="page-heading"><div><p class="eyebrow">MAKE ROOM FOR YOUR IDEA</p><h1>${empty project ? 'Create a project' : 'Edit project'}</h1><p>Give future teammates a clear picture of what you want to build.</p></div><a href="${ctx}/projects">← Back to projects</a></div><form action="${ctx}/${empty project ? 'project-create' : 'project-update'}" method="post" class="card form-card"><%@ include file="parts/csrf.jspf" %><c:if test="${not empty project}"><input type="hidden" name="id" value="${project.id}"></c:if><label>Project title<input name="title" maxlength="150" value="<c:out value='${project.title}'/>" required></label><label>Description<textarea name="description" rows="5" maxlength="10000" required><c:out value="${project.description}"/></textarea></label><label>Team requirements<textarea name="requirements" rows="3" maxlength="5000" required><c:out value="${project.requirements}"/></textarea></label><div class="grid two"><label>Category<input name="category" maxlength="80" placeholder="e.g. Education" value="<c:out value='${project.category}'/>" required></label><label>Technologies<input name="technologies" maxlength="500" placeholder="Java, MySQL, JavaScript" value="<c:out value='${project.technologies}'/>" required></label><label>Team capacity (including you)<input name="capacity" type="number" min="1" max="100" value="${empty project ? 5 : project.capacity}" required></label><label>Status<select name="status"><c:forEach items="OPEN,IN_PROGRESS,COMPLETED,ARCHIVED" var="status"><option value="${status}" ${project.status == status ? 'selected' : ''}>${status}</option></c:forEach></select></label></div><div class="actions"><button>Save project</button><a href="${ctx}/projects">Cancel</a></div></form>
