<div class="badge-list"><c:forEach items="${badges}" var="b"><div class="achievement"><span class="medal">★</span><div><strong><c:out value="${b.name}"/></strong><p><c:out value="${b.description}"/></p><small><c:out value="${b.points}"/> points · <c:out value="${b.earned_at}"/></small></div></div></c:forEach><c:if test="${empty badges}"><p class="muted">Your first achievement is ahead. Create a project, join a team, finish a task, or start a discussion.</p></c:if></div>
