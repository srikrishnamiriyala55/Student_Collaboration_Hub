<div class="task-list"><c:forEach items="${tasks}" var="t"><article class="card task"><div class="card-top"><div><span class="tag"><c:out value="${t.priority}"/> priority</span><h3><c:out value="${t.title}"/></h3></div><span class="status"><c:out value="${t.status}"/></span></div><p class="preserve"><c:out value="${t.description}"/></p><p class="muted"><a href="${ctx}/project-details?id=${t.project_id}"><c:out value="${t.project_title}"/></a> · Assigned to <c:out value="${t.assignee_name}"/> · Due <c:out value="${t.deadline}" default="Not set"/></p><c:if test="${t.project_status != 'ARCHIVED'}"><form action="${ctx}/task-status" method="post" class="actions"><%@ include file="/WEB-INF/views/parts/csrf.jspf" %><input name="id" value="${t.id}" type="hidden"><label class="compact">Update status<select name="status"><c:forEach items="PENDING,IN_PROGRESS,COMPLETED" var="st"><option value="${st}" ${t.status == st ? 'selected' : ''}>${st}</option></c:forEach></select></label><button class="small secondary">Save status</button></form></c:if><c:if test="${t.project_status == 'ARCHIVED'}"><p class="muted">This project is archived. Tasks are read-only.</p></c:if>
<c:if test="${not empty project and project.status != 'ARCHIVED'}"><details><summary>Edit task details</summary><form action="${ctx}/task-update" method="post"><%@ include file="/WEB-INF/views/parts/csrf.jspf" %><input name="id" value="${t.id}" type="hidden"><input name="projectId" value="${project.id}" type="hidden"><label>Title<input name="title" value="<c:out value='${t.title}'/>" maxlength="180" required></label><label>Description<textarea name="description" maxlength="5000"><c:out value="${t.description}"/></textarea></label><div class="grid two"><label>Assignee<select name="assigneeId"><c:forEach items="${members}" var="m"><option value="${m.id}" ${m.id == t.assignee_id ? 'selected' : ''}><c:out value="${m.name}"/></option></c:forEach></select></label><label>Priority<select name="priority"><c:forEach items="LOW,MEDIUM,HIGH" var="priority"><option ${priority == t.priority ? 'selected' : ''}>${priority}</option></c:forEach></select></label><label>Deadline<input name="deadline" type="date" value="${t.deadline}"></label><label>Status<select name="status"><c:forEach items="PENDING,IN_PROGRESS,COMPLETED" var="st"><option ${st == t.status ? 'selected' : ''}>${st}</option></c:forEach></select></label></div><button>Save task</button></form></details></c:if></article></c:forEach></div><c:if test="${empty tasks}"><div class="empty"><h3>No tasks yet</h3><p>Tasks assigned to this workspace will appear here.</p></div></c:if>
