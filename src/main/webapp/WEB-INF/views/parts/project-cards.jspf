<div class="grid three"><c:forEach items="${projects}" var="p"><article class="card project-card"><div class="card-top"><span class="tag"><c:out value="${p.category}"/></span><span class="status"><c:out value="${p.status}"/></span></div><h3><a href="${ctx}/project-details?id=${p.id}"><c:out value="${p.title}"/></a></h3><p class="clamp"><c:out value="${p.description}"/></p><p class="tech"><c:out value="${p.technologies}"/></p><c:if test="${not empty p.reason}"><div class="match"><strong><c:out value="${p.match_score}"/> match points</strong><p><c:out value="${p.reason}"/></p></div></c:if><div class="card-meta"><span>By <c:out value="${p.owner_name}"/></span><span><c:out value="${p.member_count}"/> / <c:out value="${p.capacity}"/> members</span></div><progress max="${p.task_count == 0 ? 1 : p.task_count}" value="${p.completed_count}"></progress><div class="card-meta"><span><c:out value="${p.completed_count}"/> of <c:out value="${p.task_count}"/> tasks complete</span><a href="${ctx}/project-details?id=${p.id}">View project →</a></div></article></c:forEach></div><c:if test="${empty projects}"><div class="empty"><h3>No projects here yet</h3><p>Create a project or adjust your filters to discover more.</p><a class="button" href="${ctx}/project-create">Create a project</a></div></c:if>
