<%@ page contentType="text/html; charset=UTF-8" %><%@ taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core" %>
<div class="page-heading"><div><p class="eyebrow">BETTER TOGETHER</p><h1>Find your teammates</h1><p>Discover skills, share an opportunity, and invite someone to your project.</p></div></div><form action="${ctx}/students" method="get" class="filters card"><label>Search students<input name="q" value="<c:out value='${param.q}'/>" placeholder="Name or skill"></label><button>Search</button><a href="${ctx}/students">Reset</a></form><div class="grid three"><c:forEach items="${students}" var="student"><article class="card"><div class="avatar">◎</div><h3><c:out value="${student.name}"/></h3><p class="preserve"><c:out value="${student.bio}"/></p><p><strong>Skills</strong><br><c:out value="${student.skills}" default="Not added"/></p><p class="muted">Interests: <c:out value="${student.interests}"/></p><c:if test="${student.id != sessionScope.user.id}"><c:choose><c:when test="${not empty ownedProjects}"><form action="${ctx}/team-request" method="post"><%@ include file="parts/csrf.jspf" %><input type="hidden" name="recipientId" value="${student.id}"><label>Invite to your project<select name="projectId" required><c:forEach items="${ownedProjects}" var="p"><option value="${p.id}"><c:out value="${p.title}"/></option></c:forEach></select></label><button class="full secondary">Send invitation →</button></form></c:when><c:otherwise><p class="muted">Create an open project to invite teammates.</p></c:otherwise></c:choose></c:if></article></c:forEach></div><c:if test="${empty students}"><div class="empty">No students match your search.</div></c:if>
