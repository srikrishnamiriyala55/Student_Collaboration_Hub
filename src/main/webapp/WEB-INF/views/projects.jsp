<%@ page contentType="text/html; charset=UTF-8" %><%@ taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core" %>
<div class="page-heading"><div><p class="eyebrow">DISCOVER & COLLABORATE</p><h1>Explore projects</h1><p>Find an idea that needs your perspective.</p></div><a class="button" href="${ctx}/project-create">+ Create project</a></div><div class="tabs"><a class="selected" href="${ctx}/projects">All projects</a><a href="${ctx}/recommendations">Recommended for you</a></div>
<form method="get" action="${ctx}/projects" class="filters card"><label>Search<input name="q" value="<c:out value='${param.q}'/>" placeholder="Project title or description"></label><label>Category<input name="category" value="<c:out value='${param.category}'/>" placeholder="e.g. Education"></label><label>Technology<input name="technology" value="<c:out value='${param.technology}'/>" placeholder="e.g. Java"></label><label>Status<select name="status"><option value="">All statuses</option><c:forEach items="OPEN,IN_PROGRESS,COMPLETED,ARCHIVED" var="status"><option value="${status}" ${param.status == status ? 'selected' : ''}>${status}</option></c:forEach></select></label><button>Search</button><a href="${ctx}/projects">Reset</a></form><%@ include file="parts/project-cards.jspf" %>
