<%@ page contentType="text/html; charset=UTF-8" %><%@ taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core" %>
<div class="page-heading"><div><p class="eyebrow">STAY IN THE LOOP</p><h1>Notifications & invitations</h1><p>Your latest updates and opportunities to collaborate.</p></div></div><section class="section"><h2>Team invitations</h2><div class="grid two"><c:forEach items="${requests}" var="req"><article class="card"><div class="card-top"><h3><c:out value="${req.project_title}"/></h3><span class="status"><c:out value="${req.status}"/></span></div><p><strong><c:out value="${req.sender_name}"/></strong> invited you to join this project.</p><small><c:out value="${req.created_at}"/></small><div class="actions"><a href="${ctx}/project-details?id=${req.project_id}">View project</a><c:if test="${req.status == 'PENDING'}"><form action="${ctx}/team-request-accept" method="post" class="inline"><%@ include file="parts/csrf.jspf" %><input type="hidden" name="requestId" value="${req.id}"><button class="small">Accept invitation</button></form><form action="${ctx}/team-request-reject" method="post" class="inline"><%@ include file="parts/csrf.jspf" %><input type="hidden" name="requestId" value="${req.id}"><button class="small secondary">Decline</button></form></c:if></div></article></c:forEach></div><c:if test="${empty requests}"><div class="empty">No invitations yet. New opportunities will appear here.</div></c:if></section><section class="card"><h2>Notification history</h2><c:forEach items="${notifications}" var="n"><article class="notification ${n.is_read ? '' : 'unread'}"><div><span class="tag"><c:out value="${n.type}"/></span><p><c:out value="${n.message}"/></p><small><c:out value="${n.created_at}"/></small><c:if test="${not empty n.project_id}"> · <a href="${ctx}/project-details?id=${n.project_id}">Open project</a></c:if></div><c:if test="${not n.is_read}"><form action="${ctx}/notification-read" method="post"><%@ include file="parts/csrf.jspf" %><input type="hidden" name="id" value="${n.id}"><button class="small secondary">Mark read</button></form></c:if></article></c:forEach><c:if test="${empty notifications}"><p class="muted">You’re all caught up.</p></c:if></section>
