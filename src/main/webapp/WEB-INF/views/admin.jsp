<%@ page contentType="text/html; charset=UTF-8" %><%@ taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core" %>
<div class="page-heading"><div><p class="eyebrow">ADMINISTRATION</p><h1>Community overview</h1><p>Manage accounts, moderate projects, and keep the community informed.</p></div></div><div class="grid stats admin-stats"><div class="card"><span>Students</span><strong>${stats.students}</strong></div><div class="card"><span>Projects</span><strong>${stats.projects}</strong></div><div class="card"><span>Memberships</span><strong>${stats.memberships}</strong></div><div class="card"><span>Tasks</span><strong>${stats.tasks}</strong></div><div class="card"><span>Pending invitations</span><strong>${stats.requests}</strong></div></div><section class="card section"><h2>Publish an announcement</h2><form method="post" action="${ctx}/admin/announcement"><%@ include file="parts/csrf.jspf" %><label>Message<textarea name="message" rows="2" maxlength="1000" required></textarea></label><button>Publish & notify students</button></form></section><section class="card section table-wrap"><h2>Student accounts</h2><form action="${ctx}/admin/dashboard" method="get" class="filters"><label>Search students<input name="q" value="<c:out value='${param.q}'/>" placeholder="Name or email"></label><button>Search</button></form><table><thead><tr><th>Name</th><th>Email</th><th>Role</th><th>Status</th><th>Account</th></tr></thead><tbody><c:forEach items="${students}" var="student"><tr><td><c:out value="${student.name}"/></td><td><c:out value="${student.email}"/></td><td><c:out value="${student.role}"/></td><td>${student.active ? 'Active' : 'Inactive'}</td><td><c:if test="${student.role != 'ADMIN'}"><form action="${ctx}/admin/student" method="post"><%@ include file="parts/csrf.jspf" %><input type="hidden" name="id" value="${student.id}"><input type="hidden" name="active" value="${not student.active}"><button class="small secondary">${student.active ? 'Deactivate' : 'Activate'}</button></form></c:if></td></tr></c:forEach></tbody></table></section><section class="section"><h2>Project moderation</h2><%@ include file="parts/project-cards.jspf" %></section><section class="card table-wrap section"><h2>Recent activity</h2><table><thead><tr><th>Student</th><th>Activity</th><th>Project</th><th>Time</th></tr></thead><tbody><c:forEach items="${activity}" var="a"><tr><td><c:out value="${a.name}"/></td><td><c:out value="${a.action}"/></td><td><c:if test="${not empty a.project_id}"><a href="${ctx}/project-details?id=${a.project_id}"><c:out value="${a.project_title}"/></a></c:if></td><td><c:out value="${a.created_at}"/></td></tr></c:forEach></tbody></table></section>
