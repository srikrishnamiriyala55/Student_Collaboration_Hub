<%@ page contentType="text/html; charset=UTF-8" %>
<section class="auth-layout"><div class="auth-intro"><p class="eyebrow">START SOMETHING WORTH SHARING</p><h1>Bring your skills.<br>Find your people.</h1><p class="lead">Join a community of students turning ideas into real projects.</p></div><div class="card auth-card"><h2>Create your account</h2><p class="muted">Your next collaboration starts here.</p><form action="${ctx}/register" method="post"><%@ include file="parts/csrf.jspf" %><label>Full name<input name="name" maxlength="100" autocomplete="name" required></label><label>Email address<input name="email" type="email" maxlength="190" autocomplete="email" required></label><label>Password<input name="password" type="password" minlength="8" maxlength="72" autocomplete="new-password" required><small>Use at least 8 characters.</small></label><label>Confirm password<input name="confirmPassword" type="password" minlength="8" maxlength="72" autocomplete="new-password" required></label><button class="full">Create account →</button></form><p class="auth-bottom">Already registered? <a href="${ctx}/login">Sign in</a></p></div></section>
