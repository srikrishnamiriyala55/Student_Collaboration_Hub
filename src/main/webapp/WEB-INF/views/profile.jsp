<%@ page contentType="text/html; charset=UTF-8" %><%@ taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core" %>
<div class="page-heading"><div><p class="eyebrow">LET YOUR SKILLS SPEAK</p><h1>My profile</h1><p>Help future teammates get to know you.</p></div></div><div class="grid two"><form action="${ctx}/profile" method="post" class="card"><%@ include file="parts/csrf.jspf" %><h2>Your details</h2><label>Full name<input name="name" maxlength="100" value="<c:out value='${profile.name}'/>" required></label><label>Email<input value="<c:out value='${profile.email}'/>" readonly></label><label>Skills<input name="skills" maxlength="500" value="<c:out value='${profile.skills}'/>" placeholder="Java, MySQL, JavaScript"><small>Separate skills with commas for project matching.</small></label><label>Interests<input name="interests" maxlength="500" value="<c:out value='${profile.interests}'/>" placeholder="Education, Sustainability"><small>Use category names, separated with commas.</small></label><label>About you<textarea name="bio" maxlength="1000" rows="4"><c:out value="${profile.bio}"/></textarea></label><button>Save profile</button></form><section class="card"><h2>Earned achievements</h2><%@ include file="parts/badges.jspf" %><a href="${ctx}/leaderboard">Explore the leaderboard →</a></section></div>
